{
  "name": "ritten-mcp",
  "version": "0.0.0",
  "private": true,
  "description": "A permissioned MCP gateway for your own machine",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./toolkit": {
      "types": "./dist/toolkit/index.d.ts",
      "import": "./dist/toolkit/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ritten": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs",
    "examples"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write src tests scripts docs examples .github README.md package.json tsconfig.json .prettierrc.json",
    "format:check": "prettier --check src tests scripts docs examples .github README.md package.json tsconfig.json .prettierrc.json",
    "test": "npm run build && node --test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/core": "2.4.0",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@napi-rs/keyring": "2.1.2",
    "ipaddr.js": "2.5.0",
    "tsx": "4.23.15",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
